{
  "size": [1280, 720],
  "windows": ["launcher", "leaderboard", "admin"],
  "actions": [
    { "wait": 2500 },
    { "shot": "launcher", "window": "launcher" },
    { "shot": "leaderboard", "window": "leaderboard" },
    { "shot": "admin", "window": "admin" },
    { "dispatch": { "type": "setScore", "teamId": "@team:0", "roundId": "@round:3", "value": 7 } },
    { "dispatch": { "type": "presentGoto", "step": 2 } },
    { "dispatch": { "type": "setRulesVisible", "visible": true } },
    { "wait": 3500 },
    { "shot": "leaderboard-after", "window": "leaderboard" },
    { "eval": "window.quiz.timerStart(30).then(() => true)", "window": "admin", "equals": true },
    { "wait": 700 },
    { "eval": "document.getElementById('qtimer').classList.contains('on') && Number(document.getElementById('qt-num').textContent) >= 25", "window": "leaderboard", "equals": true },
    { "eval": "window.quiz.timerStop().then(() => true)", "window": "admin", "equals": true },
    { "wait": 500 },
    { "eval": "document.getElementById('qtimer').classList.contains('on')", "window": "leaderboard", "equals": false },
    { "dispatch": { "type": "setTimerSeconds", "seconds": 60 } },
    { "expect": "presentation.timerSeconds", "equals": 60 },
    { "dispatch": { "type": "setQuestions", "roundId": "@round:0", "questions": [{ "text": "Smoke?", "options": ["a", "b", "c", "d"], "correct": 0, "notes": "SECRET-PRESENTER-NOTE" }] } },
    { "dispatch": { "type": "presentGoto", "step": 1 } },
    { "dispatch": { "type": "presentGoto", "step": 2 } },
    { "dispatch": { "type": "presentReveal" } },
    { "wait": 600 },
    { "eval": "!document.getElementById('notes').hidden && document.getElementById('notes').textContent.includes('SECRET-PRESENTER-NOTE')", "window": "admin", "equals": true },
    { "eval": "document.body.innerText.includes('SECRET-PRESENTER-NOTE') || document.documentElement.innerHTML.includes('SECRET-PRESENTER-NOTE')", "window": "leaderboard", "equals": false },
    { "dispatch": { "type": "setHomeVisible", "visible": true } },
    { "wait": 1500 },
    { "eval": "document.getElementById('home').classList.contains('on')", "window": "leaderboard", "equals": true },
    { "shot": "leaderboard-home", "window": "leaderboard" },
    { "dispatch": { "type": "setHomeVisible", "visible": false } },
    { "dispatch": { "type": "setFlow", "flow": { "sectionPages": true } } },
    { "dispatch": { "type": "presentGoto", "step": 1 } },
    { "wait": 1200 },
    { "eval": "document.getElementById('secpage').classList.contains('on') && document.getElementById('secpage-name').textContent.length > 0", "window": "leaderboard", "equals": true },
    { "dispatch": { "type": "setFlow", "flow": { "sectionPages": false } } },
    { "wait": 1200 },
    { "eval": "document.getElementById('secpage').classList.contains('on')", "window": "leaderboard", "equals": false },
    { "eval": "document.getElementById('present-mode').click(), true", "window": "admin", "equals": true },
    { "wait": 700 },
    { "eval": "document.querySelectorAll('#pm .up').length > 0 && document.querySelectorAll('#pm .up-pill').length === 2", "window": "admin", "equals": true },
    { "branding": { "appName": "Smoke Test" } },
    { "wait": 800 }
  ]
}
